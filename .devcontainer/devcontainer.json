{
  // The shared MDB website Codespace (Josh, 2026-10-05): one Codespace, one Claude login,
  // everyone just prompts. Rules for Claude: knowledge/codespace.md
  "name": "Mom's Design Build website",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 2 },
  // Claude Code baked into the image (the npm -g step in postCreate didn't land on 10/5)
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Josh 10/5: the team runs on Sonnet 5.5 to keep usage down (Codespace only; the mini's bot is separate)
  "containerEnv": { "ANTHROPIC_MODEL": "claude-sonnet-5-5" },
  "postCreateCommand": "npm install",
  "postAttachCommand": "echo; echo '  MDB website. Type  claude  and say what you want changed.'; echo",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Website preview", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "settings": { "terminal.integrated.defaultProfile.linux": "bash" }
    }
  }
}
